APP_NAME=meeting-platform
DATABASE_URL=sqlite+aiosqlite:///./meeting.db
SECRET_KEY=change-me-in-prod
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5133","http://127.0.0.1:5133"]

# ---------- Speech-to-text ----------
STT_PROVIDER=groq
# turbo is the fast model; large-v3 is used automatically when turbo is unsure
STT_MODEL=whisper-large-v3
STT_FALLBACK_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
# Keep the prompt SHORT. Long prompts get echoed back as hallucinations.
STT_PROMPT=Technical interview about Python, FastAPI, PostgreSQL, Redis, Kubernetes, Docker, AWS and Terraform.
STT_USE_PROMPT=true
STT_PROMPT_MAX_WORDS=40
# off | safe (deterministic only) | llm (deterministic + guarded LLM polish)
STT_CLEANUP=llm
STT_MIN_SPEECH_MS=320
STT_LOGPROB_THRESHOLD=-1.10
STT_NO_SPEECH_THRESHOLD=0.55
STT_COMPRESSION_RATIO_THRESHOLD=2.4
STT_VERIFY_WITH_FALLBACK=false
GROQ_API_KEY=your_groq_api_key_here

# ---------- LLM (Groq first, OpenRouter fallback) ----------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_SECONDARY_MODEL=openai/gpt-oss-120b
LLM_GRAPH_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=45
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK=openrouter/free

# ---------- Knowledge graph ----------
GRAPH_AUTO_REBUILD=true
GRAPH_REBUILD_DEBOUNCE_S=5
GRAPH_MAX_NODES=60
GRAPH_MAX_EDGES=120
GRAPH_LLM_ENRICH=true
# off | deepfilter | rnnoise (DeepFilterNet3 binary: backend/bin/deep-filter.exe)
STT_DENOISE=off
STT_DENOISE_BELOW_SNR_DB=15
STT_HIGHPASS_HZ=80
